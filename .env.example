# Copy to .env (development) or .env.production (Docker Compose).
# Never commit a filled-in copy.

# ---------------------------------------------------------------------------
# Required everywhere
# ---------------------------------------------------------------------------

# The SQLite file. In production this must be a path on the persistent
# volume, not inside the image.
DATABASE_URL="file:./dev.db"

# Signs session cookies and hashes magic-link tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it signs everyone out.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# The public origin. Auth.js builds sign-in callback URLs from the request's
# Host header unless this is set — behind a proxy that does not normalise it,
# a forged header can send a working sign-in link somewhere else.
# AUTH_URL="https://example.com"

# The hostname Caddy serves and requests a TLS certificate for. Must be the
# same host as AUTH_URL: Caddy issues the certificate for this name, and
# Auth.js builds its callbacks from that one, so a mismatch produces a valid
# certificate for an origin nothing is served on. Use "localhost" for a local
# Compose run, which makes Caddy issue its own certificate instead of asking
# Let's Encrypt for one it could never validate.
# SITE_DOMAIN="example.com"

# A transactional email provider. Per D6 this is the only third party that
# sees a user's address, and the message carries a login link, never resume
# content.
# EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
# EMAIL_FROM="ATS Resume Builder <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------

# Writes each sign-in email to this directory as JSON instead of sending it,
# so the whole magic-link flow works without an email account. Refuses to run
# when NODE_ENV=production, so leaving it set cannot leak links in a deploy.
AUTH_DEV_OUTBOX=".mail-outbox"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Google sign-in. Both or neither — half-configured renders a button that
# fails after redirecting away from the site. The authorized redirect URI is
# <origin>/api/auth/callback/google.
#
# Check them before a deploy, which asks Google itself rather than guessing:
#   AUTH_GOOGLE_ID=… AUTH_GOOGLE_SECRET=… AUTH_URL=… pnpm auth:google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# The OpenID issuer Google sign-in discovers from. **Leave this unset.** It
# exists so the end-to-end suite can run the real OAuth path against a local
# provider; anything that is not https, or http on loopback, is ignored in
# favour of Google.
# AUTH_GOOGLE_ISSUER=

# Where `scripts/backup.mjs` writes snapshots. Must be on the volume.
# BACKUP_DIR="/data/backups"

# Off-site replication (D9). Only read when the `litestream` service in
# docker-compose.yml is uncommented. These are S3 credentials for the bucket
# named in litestream.yml — on Oracle Cloud they are Customer Secret Keys,
# not API signing keys.
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# The server applies pending migrations on first use, so a deploy needs no
# separate migrate step. Set to 1 to run them as a deliberate command instead
# (see docs/RUNBOOK.md).
# SKIP_AUTO_MIGRATE=0
