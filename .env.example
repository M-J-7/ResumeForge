# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth.js (M2-T2). Both flows are passwordless per D7 — there is no password
# column in the schema and there never will be.
# ---------------------------------------------------------------------------

# Required in every environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# The origin Auth.js builds callback URLs against. Leave unset for local
# development; set it in production so a forged Host header cannot redirect
# a sign-in link somewhere else.
# AUTH_URL="https://example.com"

# --- Magic link delivery: exactly one of the two blocks below ---

# Production. A transactional email provider. Per D6 this is the only piece
# of third-party infrastructure that sees a user's address, and it carries a
# login link — never resume content.
# EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
# EMAIL_FROM="ATS Resume Builder <no-reply@example.com>"

# Development and CI. Writes each sign-in email to this directory as JSON so
# the flow can be exercised end to end without an email account. Refuses to
# run when NODE_ENV=production.
AUTH_DEV_OUTBOX=".mail-outbox"

# --- Google (optional; the email flow works without it) ---
# From a Google Cloud project's OAuth consent screen + credentials. The
# authorized redirect URI is <origin>/api/auth/callback/google.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
