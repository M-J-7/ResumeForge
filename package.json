    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "10.1.8",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
